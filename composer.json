{
    "name": "langsys/laravel-access-guard",
    "description": "Entity-scoped RBAC for Laravel: users hold roles within entities (orgs, projects, teams), API keys are first-class authorizable subjects, with super-admin bypass and collection filtering.",
    "type": "library",
    "keywords": [
        "laravel",
        "authorization",
        "rbac",
        "permissions",
        "roles",
        "access-control",
        "multi-tenant"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Langsys",
            "email": "dev@flexmarkintl.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "suggest": {
        "langsys/laravel-api-keys": "Treat API keys as first-class authorizable subjects alongside users."
    },
    "autoload": {
        "psr-4": {
            "Langsys\\AccessGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Langsys\\AccessGuard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Langsys\\AccessGuard\\AccessGuardServiceProvider"
            ],
            "aliases": {
                "AccessGuard": "Langsys\\AccessGuard\\Facades\\AccessGuard"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
